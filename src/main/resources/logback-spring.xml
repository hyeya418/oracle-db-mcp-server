<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_FILE" value="${LOG_FILE:-${user.home}/oracle-db-mcp-server.log}"/>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- STDIO transport reserves stdout for JSON-RPC: do not attach a console appender -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
